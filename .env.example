# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL Database Connection for Drizzle ORM
# (Found in Supabase Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
